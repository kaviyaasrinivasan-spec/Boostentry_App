{
  "expo": {
    "name": "BoostEntry",
    "slug": "boostentry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "boostentry",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BoostEntry needs camera access to capture invoices for processing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.ashraf_damzz.boostentry"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BoostEntry to access your camera to capture invoices."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BoostEntry to access your photos to upload invoices."
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
